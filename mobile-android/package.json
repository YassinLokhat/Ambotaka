{
  "name": "roadpulse-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@maplibre/maplibre-react-native": "^10.0.0",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-background-fetch": "~13.0.0",
    "expo-build-properties": "~0.13.1",
    "expo-constants": "~17.0.0",
    "expo-crypto": "~14.0.0",
    "expo-dev-client": "~5.0.20",
    "expo-linking": "~7.0.0",
    "expo-location": "~18.0.0",
    "expo-notifications": "~0.29.0",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-sqlite": "~15.1.4",
    "expo-status-bar": "~2.0.0",
    "expo-task-manager": "~12.0.0",
    "query-string": "^7.1.3",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/react": "~18.3.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "~5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "globals": {
      "ts-jest": {
        "tsconfig": {
          "strict": true,
          "esModuleInterop": true,
          "target": "ES2020",
          "module": "commonjs",
          "skipLibCheck": true,
          "types": [
            "jest"
          ]
        }
      }
    }
  }
}
