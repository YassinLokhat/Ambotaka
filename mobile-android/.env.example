# Émulateur Android -> machine hôte : 10.0.2.2 ; téléphone réel : IP LAN de votre PC ; PRODUCTION : https://api.votre-domaine
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api/v1
# Clé TomTom réservée à l'AFFICHAGE de la carte (service « Maps » seul). Ne jamais y mettre la clé Routing/Search.
EXPO_PUBLIC_TOMTOM_MAP_KEY=
# Optionnels : style personnalisé complet, texte d'attribution
# EXPO_PUBLIC_MAP_STYLE_URL=
# EXPO_PUBLIC_MAP_ATTRIBUTION=
